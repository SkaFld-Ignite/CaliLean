{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_MEDUSA_BACKEND_URL",
        "NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_BASE_URL",
        "NEXT_PUBLIC_DEFAULT_REGION",
        "NEXT_PUBLIC_SEARCH_ENDPOINT",
        "NEXT_PUBLIC_MINIO_ENDPOINT",
        "NEXT_PUBLIC_STRIPE_KEY",
        "NEXT_PUBLIC_SANITY_PROJECT_ID"
      ],
      "inputs": [
        "src/**",
        "public/**",
        "package.json",
        "tsconfig.json",
        "next.config.js",
        "medusa-config.ts",
        "tailwind.config.js",
        "postcss.config.js"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        ".medusa/server/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "inputs": ["src/**"],
      "outputs": []
    },
    "test": {
      "inputs": ["src/**", "integration-tests/**"],
      "outputs": []
    },
    "seed": {
      "cache": false,
      "outputs": []
    }
  }
}
